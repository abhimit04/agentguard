POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
AGENTGUARD_API_KEY=replace-with-a-long-random-integration-secret
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=replace-with-google-oauth-client-id
OIDC_CLIENT_SECRET=replace-with-google-oauth-client-secret
OIDC_REDIRECT_URI=https://agentguard.example.com/auth/callback
AGENTGUARD_HOST=agentguard.example.com
AGENTGUARD_PUBLIC_ORIGIN=https://agentguard.example.com
GOOGLE_WORKSPACE_DOMAIN=example.com
JWT_SECRET=replace-with-a-long-random-session-secret
# Optional independent HMAC secret for signing workspace-bound audit cursors; defaults to JWT_SECRET.
AGENTGUARD_AUDIT_CURSOR_SECRET=
# Generate an Ed25519 pair with: node scripts/generate-audit-signing-key.js
AGENTGUARD_AUDIT_SIGNING_PRIVATE_KEY_FILE=./secrets/audit-signing-private.pem
AGENTGUARD_AUDIT_SIGNING_KEY_ID=agentguard-local-2026
# Optional independent backup-manifest signing. The public key must be retained outside the backup directory.
AGENTGUARD_BACKUP_MANIFEST_SIGNING_PRIVATE_KEY_FILE=
AGENTGUARD_BACKUP_MANIFEST_SIGNING_KEY_ID=
AGENTGUARD_BACKUP_MANIFEST_PUBLIC_KEY_FILE=
AGENTGUARD_REQUIRE_AUTH=true
AGENTGUARD_OWNER_EMAIL=abhimit04@gmail.com
AGENTGUARD_ROLE_MAP=abhimdi15@gmail.com:reviewer,abhimit04@gmail.com:operator
AGENTGUARD_DEFAULT_WORKSPACE_ID=default
# Optional per-user workspace routing: user@example.com=workspace-id,other@example.com=other-workspace
AGENTGUARD_WORKSPACE_MAP=
# Comma-separated private/local hosts explicitly approved for managed polling.
AGENTGUARD_RUNTIME_HOST_ALLOWLIST=
# Pending approvals are denied automatically after this duration.
AGENTGUARD_APPROVAL_TTL_MS=900000
# Notify reviewers this many days before an approved assessment is due (1-90).
AGENTGUARD_ASSESSMENT_REMINDER_DAYS=7
AGENTGUARD_EXECUTION_UNCERTAIN_AFTER_MS=300000
# Requests per minute for a caller on general integration routes.
AGENTGUARD_RATE_LIMIT=240
# Telemetry-specific fair-use limits. A company is capped across its agents;
# each individual agent also has its own independent cap.
AGENTGUARD_COMPANY_RATE_LIMIT=2400
AGENTGUARD_AGENT_RATE_LIMIT=240
AGENTGUARD_MAX_BODY_BYTES=1000000
# Set false only for a single-instance local development database. PostgreSQL is
# the default shared limiter when AGENTGUARD_STORAGE=postgres.
AGENTGUARD_SHARED_RATE_LIMIT=true
AGENTGUARD_ALERT_WEBHOOK_URL=
AGENTGUARD_ALERT_WEBHOOK_TOKEN=
