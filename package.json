{
  "name": "agent-guard",
  "version": "1.0.0",
  "description": "AgentGuard is an AI agent control tower for mid-market teams.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "ui": "vite --host 0.0.0.0",
    "build": "vite build",
    "backup:postgres": "node --env-file=.env scripts/backup-postgres.js",
    "inspect:postgres-cutover": "node --env-file=.env scripts/inspect-postgres-cutover.js",
    "inspect:local-cutover": "node --env-file=.env scripts/inspect-local-cutover.js",
    "migrate:relational": "node --env-file=.env scripts/migrate-relational-postgres.js",
    "manifest:backup": "node scripts/postgres-backup-manifest.js",
    "check:backup-freshness": "node scripts/check-backup-freshness.js",
    "restore-drill:postgres": "node --env-file=.env scripts/restore-drill-postgres.js",
    "smoke:postgres": "node --env-file=.env scripts/smoke-postgres.js",
    "smoke:proxy": "node --env-file=.env scripts/smoke-production-proxy.js",
    "test:governed-postgres": "node --env-file=.env scripts/test-governed-execution-postgres.js",
    "test:audit-export-postgres": "node --env-file=.env scripts/test-audit-export-postgres.js",
    "test:legal-holds-postgres": "node --env-file=.env scripts/test-legal-holds-postgres.js",
    "test:telemetry-postgres": "node --env-file=.env scripts/test-telemetry-postgres.js",
    "test:rate-limit-postgres": "node --env-file=.env scripts/test-rate-limit-multi-instance-postgres.js",
    "verify:audit": "node --env-file=.env scripts/verify-audit-chain.js",
    "verify:audit-export": "node scripts/verify-audit-export.js",
    "archive:audit-export": "node scripts/archive-audit-export.js",
    "verify:audit-archive": "node scripts/verify-audit-archive.js",
    "migrate:audit": "node --env-file=.env scripts/migrate-audit-chain.js",
    "agents:test": "node examples/test-agents/run-both.mjs",
    "agents:five": "node examples/test-agents/five-agent-demo.mjs",
    "agents:prod-demo": "node examples/test-agents/production-demo.mjs"
  },
  "keywords": [],
  "author": "AgentGuard",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
